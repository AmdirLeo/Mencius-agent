# ⭐ 必需配置 - 从 https://open.bigmodel.cn/ 获取
GLM_API_KEY=sk-your_glm_api_key_here

# 应用配置
APP_NAME=Mencius Agent
APP_VERSION=0.1.0
DEBUG=True
BACKEND_PORT=8000
FRONTEND_URL=http://localhost:5173

# 向量模型配置
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-mpnet-base-v2

# 可选：如果想用 Qdrant 替代 FAISS
# VECTOR_DB_TYPE=qdrant
# VECTOR_DB_URL=http://localhost:6333
# VECTOR_DB_COLLECTION_NAME=mencius

